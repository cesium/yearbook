<div class="flex flex-col gap 2">
  <div class="flex gap-3">
    <button
      phx-click="choose_licenciatura"
      class="pb-2 relative group focus:outline-none"
    >
      <span class="text-sm font-bold tracking-wide uppercase hover:text-main">
        {gettext("Licenciatura")}
      </span>
    </button>

    <button
      phx-click="choose_mestrado"
      class="pb-2 relative group focus:outline-none"
    >
      <span class="text-sm font-bold tracking-wide uppercase hover:text-main">
        {gettext("Mestrado")}
      </span>
    </button>
  </div>

  <div>
    <button
      phx-click="make_request"
      class="pb-2 relative group focus:outline-none"
    >
      <span class="text-sm font-bold tracking-wide uppercase hover:text-main">
        {gettext("Pedido")}
      </span>
    </button>
  </div>
</div>
