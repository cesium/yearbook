<div class="z-10 flex justify-end items-center grow h-full my-auto">
  <div class="flex flex-col justify-stretch bg-white w-full md:w-150 h-fit rounded-2xl py-8 px-5 sm:p-8 my-auto gap-8 mr-5 ml-5">
    <div class="flex flex-row">
      <div class="flex-1 flex-col gap-2">
        <h1 class="text-3xl font-bold tracking-normal text-black">
          Sign in to
        </h1>
        <h1 class="text-5xl font-bold tracking-normal text-black">
          Yearbook
        </h1>
      </div>
    </div>
    <div class="flex flex-col gap-4">
      <div class="flex flex-col">
        
        <.live_component
          module={YearbookWeb.SignInLive.FormComponent}
          id="sign-in-form-component"
          form={@form}
        />
      
      </div>
      <div class="flex flex-col gap-3">
        <.button
          class="h-12 w-full hover:scale-101 transition-transform bg-primary rounded"
          variant="primary"
        >
          Sign in
        </.button>
        <div class=" text-center">
          <span class="text-black">Don't have an account? </span>
          <a
            class="inline-block text-primary underline cursor-pointer hover:text-[#E37044] hover:scale-110 transition-all"
            href="/signup"
          >
            Sign up
          </a>
        </div>
      </div>
    </div>
  </div>
</div>