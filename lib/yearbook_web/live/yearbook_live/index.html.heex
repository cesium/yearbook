<div class="max-w-screen-2xl mx-auto w-full pt-4 md:pt-10 bg-app-bg">
  <div class="mb-8">
    <div class="flex items-center gap-4">
      <h1 class="text-4xl md:text-5xl font-orbitron font-bold text-main tracking-tight">
        {gettext("Yearbook")}
      </h1>

      <div class="mt-2">
        <.academic_year year={@filters["year"]} masters={@filters["masters"]} />
      </div>
    </div>

    <div class="flex items-center justify-between mt-8">
      <div class="flex gap-7">
        <button
          phx-click="filter_changed"
          phx-value-masters=""
          phx-value-year={@filters["year"]}
          class="pb-2 relative group focus:outline-none"
        >
          <span class={"text-sm font-orbitron font-bold tracking-wide uppercase #{if @filters["masters"] == "", do: "text-main", else: "text-gray-400 hover:text-gray-600"}"}>
            {gettext("Todos")}
          </span>
          <%= if @filters["masters"] == "" do %>
            <div class="absolute bottom-0 left-0 w-full h-0.5 bg-main"></div>
          <% end %>
        </button>

        <button
          phx-click="filter_changed"
          phx-value-masters="false"
          phx-value-year={@filters["year"]}
          class="pb-2 relative group focus:outline-none"
        >
          <span class={"text-sm font-orbitron font-bold tracking-wide uppercase #{if @filters["masters"] == "false", do: "text-main", else: "text-gray-400 hover:text-gray-600"}"}>
            {gettext("Licenciatura")}
          </span>
          <%= if @filters["masters"] == "false" do %>
            <div class="absolute bottom-0 left-0 w-full h-0.5 bg-main"></div>
          <% end %>
        </button>

        <button
          phx-click="filter_changed"
          phx-value-masters="true"
          phx-value-year={@filters["year"]}
          class="pb-2 relative group focus:outline-none"
        >
          <span class={"text-sm font-orbitron font-bold tracking-wide uppercase #{if @filters["masters"] == "true", do: "text-main", else: "text-gray-400 hover:text-gray-600"}"}>
            {gettext("Mestrado")}
          </span>
          <%= if @filters["masters"] == "true" do %>
            <div class="absolute bottom-0 left-0 w-full h-0.5 bg-main"></div>
          <% end %>
        </button>
      </div>
    </div>

    <p class="mt-6 text-gray-500 max-w-2xl text-sm leading-relaxed">
      <%= case {@filters["masters"], @filters["year"]} do %>
        <% {"", ""} -> %>
          {gettext("Todos os alunos registados no Yearbook.")}
        <% {"true", ""} -> %>
          {gettext("Alunos do Mestrado de todos os anos letivos.")}
        <% {"false", ""} -> %>
          {gettext("Alunos da Licenciatura de todos os anos letivos.")}
        <% {masters, year} -> %>
          {gettext("Alunos %{degree} do Ano Letivo %{year}.", %{
            degree:
              if(masters == "true", do: gettext("do Mestrado"), else: gettext("da Licenciatura")),
            year: format_academic_year(String.to_integer(year))
          })}
      <% end %>
    </p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-8 gap-y-10">
    <%= for entry <- @entries do %>
      <.entry_card name={entry.name} text={entry.text} src={entry.photo} />
    <% end %>
  </div>
  <div :if={@total_pages > 1} class="mt-16 border-t border-gray-100">
    <.pagination
      params={@params}
      meta={
        %{
          total_pages: @total_pages,
          current_page: @current_page_num,
          total_count: @total_count,
          current_offset: (@current_page_num - 1) * 10,
          next_offset: min(@current_page_num * 10, @total_count),
          previous_page: @current_page_num - 1,
          next_page: @current_page_num + 1,
          has_previous_page?: @current_page_num > 1,
          has_next_page?: @current_page_num < @total_pages
        }
      }
    />
  </div>
</div>
